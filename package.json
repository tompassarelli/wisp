{
  "name": "waygate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "postinstall": "bun node_modules/@effect/tsgo/dist/effect-tsgo.cjs patch --typescript --typescript-package typescript-native",
    "check": "bun node_modules/typescript-native/bin/tsc --build tsconfig.json tsconfig.game.json --noEmit",
    "test": "bun test",
    "ci": "bun run check && bun run test"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.0",
    "@types/bun": "1.4.2",
    "lua-types": "2.14.1",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "effect": "4.0.1",
    "source-map": "0.7.6",
    "typescript": "6.0.2",
    "typescript-to-lua": "1.37.1"
  }
}
