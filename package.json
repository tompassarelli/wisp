{
  "name": "wisp",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "exports": {
    "./src/sim/*": "./src/sim/*.ts",
    "./src/runtime/*": "./src/runtime/*.ts",
    "./src/platform/*": "./src/platform/*.ts",
    "./src/headless/*": "./src/headless/*.ts",
    "./src/natives/warcraft.d.ts": "./src/natives/warcraft.d.ts",
    "./scripts/wisp/*": "./scripts/wisp/*.ts",
    "./scripts/platform/*": "./scripts/platform/*.ts",
    "./scripts/warcraft/*": "./scripts/warcraft/*.ts",
    "./scripts/cleanRoom": "./scripts/cleanRoom.ts",
    "./scripts/compiler": "./scripts/compiler.ts",
    "./scripts/mapInfo": "./scripts/mapInfo.ts",
    "./scripts/objectData": "./scripts/objectData.ts",
    "./plugins/number-rules-service.cjs": "./plugins/number-rules-service.cjs",
    "./vendor/war3-model.mjs": "./vendor/war3-model.mjs"
  },
  "scripts": {
    "postinstall": "bun node_modules/@effect/tsgo/dist/effect-tsgo.cjs patch --typescript --typescript-package typescript-native",
    "check": "bun node_modules/typescript-native/bin/tsc --build tsconfig.json tsconfig.browser.json tsconfig.game.json examples/sample/tsconfig.json examples/sample/tsconfig.map.json examples/sample/tsconfig.tests.json examples/sample/tsconfig.headless.json --noEmit && bun scripts/numberRules.ts tsconfig.game.json examples/sample/tsconfig.map.json examples/sample/tsconfig.tests.json examples/sample/tsconfig.headless.json",
    "test": "bun scripts/wisp/testRunner.ts",
    "wisp": "bun scripts/wisp/repo.ts",
    "ci": "bun scripts/wisp/repo.ts ci post-merge",
    "package": "bun scripts/package.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@types/bun": "1.4.2",
    "lua-types": "2.14.1"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.2",
    "@effect/platform-node-shared": "4.0.2",
    "dds-parser": "1.0.1",
    "effect": "4.0.2",
    "gl-matrix": "3.3.0",
    "source-map": "0.7.6",
    "typescript": "6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "typescript-to-lua": "1.37.1",
    "w3gjs": "4.3.0"
  }
}
