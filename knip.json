{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "host/toolchain/natives.ts",
    "host/checks/prePush.ts",
    "host/browser/headlessRender.ts",
    "host/browser/standalone.ts",
    "host/compile/ciMapBuild.ts",
    "host/compile/windowEmbedCheck.ts",
    "host/window/probeChild.ts",
    "host/testing/journeyRun.ts",
    "host/lan/dummySession.ts",
    "host/lan/pairAgent.ts",
    "host/lan/pairSession.ts",
    "host/testing/registryRun.ts",
    "host/client/restorePreferences.ts",
    "host/soak/soakWorker.ts",
    "host/testing/testCostPreload.ts",
    "vendor/war3-model.d.mts",
    "test/**/*.ts",
    "src/**/*.{test,tests}.ts",
    "plugins/*.ts",
    "examples/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "host/**/*.{ts,mjs}",
    "plugins/**/*.ts",
    "test/**/*.ts",
    "examples/**/*.ts",
    "vendor/*.{mjs,mts}"
  ],
  "typescript": {
    "config": [
      "tsconfig*.json",
      "test/tsconfig*.json",
      "examples/sample/tsconfig*.json"
    ]
  },
  "ignoreDependencies": [
    "@effect/platform-node-shared",
    "@effect/tsgo",
    "@effect/language-service"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreBinaries": [
    "jq"
  ]
}
