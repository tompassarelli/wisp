{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "lua-types/5.3"],
    "paths": { "wisp/*": ["../../*"] }
  },
  "include": ["scripts/**/*.ts", "test/**/*.test.ts", "../../src/natives/warcraft.d.ts"]
}
