From 2e61b3ed83350c04fb9df92ecb5cf0fad39e0509 Mon Sep 17 00:00:00 2001
From: tompassarelli <tom.passarelli@protonmail.com>
Date: Thu, 8 Oct 2026 04:09:43 +0800
Subject: [PATCH] Preserve precision in HD environment sampling

---
 renderer/shaders/webgl/prefilterEnv.fs.glsl | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/renderer/shaders/webgl/prefilterEnv.fs.glsl b/renderer/shaders/webgl/prefilterEnv.fs.glsl
index 25f5bdf..15901fa 100644
--- a/renderer/shaders/webgl/prefilterEnv.fs.glsl
+++ b/renderer/shaders/webgl/prefilterEnv.fs.glsl
@@ -1,5 +1,5 @@
 #version 300 es
-precision mediump float;
+precision highp float;
 
 out vec4 FragColor;
 
@@ -70,4 +70,4 @@ void main() {
     prefilteredColor = prefilteredColor / totalWeight;
 
     FragColor = vec4(prefilteredColor, 1.0);
-}
\ No newline at end of file
+}
