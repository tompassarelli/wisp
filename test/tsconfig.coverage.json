{
  "compilerOptions": {
    "target": "ESNext", "lib": ["ESNext"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noEmitOnError": true, "skipLibCheck": true, "types": ["lua-types/5.3"],
    "rootDir": "..", "outDir": "../build/coverage-tests"
  },
  "include": ["coverage/lua.ts"],
  "tstl": {
    "luaTarget": "5.3", "luaBundle": "coverage.lua", "luaBundleEntry": "coverage/lua.ts",
    "noImplicitSelf": true, "noHeader": true,
    "luaPlugins": [{ "name": "../plugins/warcraft-numbers.ts" }]
  }
}
