{
  "compilerOptions": {
    "target": "ESNext", "lib": ["ESNext"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noEmitOnError": true,
    "skipLibCheck": true, "types": ["lua-types/5.3"], "rootDir": "..",
    "outDir": "../build/meter-tests"
  },
  "include": ["frameMeter/entry.ts", "../src/natives/warcraft.d.ts"],
  "tstl": {
    "luaTarget": "5.3", "luaBundle": "map.lua", "luaBundleEntry": "frameMeter/entry.ts",
    "noImplicitSelf": true, "noHeader": true,
    "luaPlugins": [{ "name": "../plugins/warcraft-numbers.ts" }]
  }
}
